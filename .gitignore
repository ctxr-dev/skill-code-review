# OS noise
.DS_Store
*.tgz

# Runtime caches — the skill's persistent run directory stays gitignored.
.skill-code-review/

# Wiki perf caches — regenerable from a rebuild, large, no value in version control
reviewers.wiki/.llmwiki/similarity-cache/
reviewers.wiki/.llmwiki/embedding-cache/
# Decision-log: 58MB record of every per-pair clustering verdict.
# Useful for retro debugging via re-run; not needed at runtime.
reviewers.wiki/.llmwiki/decisions.yaml
# Build-time work artefacts — transient.
reviewers.wiki/.work/

# Python tooling
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# logs
logs
.ctxr-fsm
